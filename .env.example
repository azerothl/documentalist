# URL utilisée pour vérifier l’origine des actions et générer les liens publiés.
DOCUMENTALIST_URL=http://localhost:3000

# SMTP utilisé pour les invitations de comptes et les accès par lien magique.
# Encodage URL requis pour les caractères réservés dans le nom ou mot de passe.
# DOCUMENTALIST_SMTP_URL=smtps://user:password@smtp.example.com:465
# DOCUMENTALIST_EMAIL_FROM="Documentalist <noreply@example.com>"

# En production HTTPS, conserver la valeur true. false est réservé à un serveur
# local lancé avec npm start sur HTTP.
DOCUMENTALIST_COOKIE_SECURE=true

# Facultatif : chemin absolu vers un volume persistant.
# DOCUMENTALIST_DATA_DIR=D:/documentalist-data

# Facultatif : clé AES de 32 octets en base64 provenant d’un gestionnaire de secrets.
# Sinon une clé est créée dans data/encryption.key. La conserver avec les sauvegardes.
# DOCUMENTALIST_ENCRYPTION_KEY=

# Facultatif : code initial connu de l’opérateur ; sinon data/setup-token est créé.
# DOCUMENTALIST_SETUP_TOKEN=

# Exceptions explicites pour un GitLab / proxy interne. Hôtes exacts, séparés
# par des virgules. Vide par défaut ; les réseaux privés sont alors bloqués.
# Les providers locaux Ollama / LM Studio / vLLM (127.0.0.1) sont autorisés
# nativement sans cette variable.
# DOCUMENTALIST_PRIVATE_HOSTS=gitlab.internal.example

# Confidentialité : à renseigner par l’exploitant de chaque instance.
# Documentalist est un logiciel libre ; le projet ne détermine pas le responsable
# de traitement de l’instance, ses finalités, ses bases légales ou ses prestataires.
# DOCUMENTALIST_PRIVACY_CONTROLLER="Nom légal de l’organisation responsable"
# DOCUMENTALIST_PRIVACY_ADDRESS="Adresse postale du responsable"
# DOCUMENTALIST_PRIVACY_CONTACT=privacy@example.org
# Facultatif : contact du DPO si l’organisation en a désigné un.
# DOCUMENTALIST_PRIVACY_DPO="Nom et coordonnées du DPO"
# Préciser les finalités et bases légales effectivement retenues.
# DOCUMENTALIST_PRIVACY_BASES="Administration des comptes : ... ; sécurité : ..."
# Lister l’hébergeur, SMTP, IA, imports, webhooks et autres destinataires activés.
# DOCUMENTALIST_PRIVACY_RECIPIENTS="Hébergeur ... ; SMTP ... ; aucun fournisseur IA"
# Indiquer les pays et garanties de transfert, ou « Aucun transfert hors EEE ».
# DOCUMENTALIST_PRIVACY_TRANSFERS="Aucun transfert hors EEE"

# Conservation technique par défaut : journal 180 jours, instantanés internes
# 30 jours, sauvegardes locales produites par npm run data:backup 30 jours.
# La purge a lieu à la prochaine activité de l’application ou sauvegarde.
# Les plages autorisées sont de 1 à 3650 jours.
# DOCUMENTALIST_ACTIVITY_RETENTION_DAYS=180
# DOCUMENTALIST_SNAPSHOT_RETENTION_DAYS=30
# DOCUMENTALIST_BACKUP_RETENTION_DAYS=30
