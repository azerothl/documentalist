# URL utilisée pour vérifier l’origine des actions et générer les liens publiés.
DOCUMENTALIST_URL=http://localhost:3000

# En production HTTPS, conserver la valeur true. false est réservé à un serveur
# local lancé avec npm start sur HTTP.
DOCUMENTALIST_COOKIE_SECURE=true

# Facultatif : chemin absolu vers un volume persistant.
# DOCUMENTALIST_DATA_DIR=D:/documentalist-data

# Facultatif : clé AES de 32 octets en base64 provenant d’un gestionnaire de secrets.
# Sinon une clé est créée dans data/encryption.key. La conserver avec les sauvegardes.
# DOCUMENTALIST_ENCRYPTION_KEY=

# Facultatif : code initial connu de l’opérateur ; sinon data/setup-token est créé.
# DOCUMENTALIST_SETUP_TOKEN=

# Exceptions explicites pour un LLM local ou un GitLab interne. Hôtes exacts,
# séparés par des virgules. Vide par défaut ; les réseaux privés sont alors bloqués.
# DOCUMENTALIST_PRIVATE_HOSTS=localhost,127.0.0.1
